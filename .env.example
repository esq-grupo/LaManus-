# Copiar para .env (nunca fazer commit do .env). Valores abaixo são FICTÍCIOS, só para desenvolvimento local.

# Dono das tabelas: migrações, seed, administração. NUNCA usado pelo código da aplicação.
ADMIN_DATABASE_URL="postgresql://lamanus:lamanus_dev@localhost:5432/lamanus?schema=public"
# Papel de EXECUÇÃO da aplicação (menor privilégio; criado por docker/db/papeis.sql). É o que a aplicação usa.
DATABASE_URL="postgresql://lamanus_app:lamanus_app_dev@localhost:5432/lamanus?schema=public"

# Usados pelo docker compose (criação da base e do papel da aplicação).
POSTGRES_USER=lamanus
POSTGRES_PASSWORD=lamanus_dev
POSTGRES_DB=lamanus
APP_DB_PASSWORD=lamanus_app_dev

# Palavra-passe FICTÍCIA das contas de desenvolvimento criadas pelo seed (nunca usar em produção).
SEED_PASSWORD="Dev-Apenas-Local-2026"
# URL base usada nos links de email (convite/recuperação).
APP_URL="http://localhost:3000"
