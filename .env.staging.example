# Copiar para .env.staging (NUNCA fazer commit; permissões 600). Substituir TODOS os valores por segredos fortes e únicos.
DOMINIO=lamanu.exemplo.edu.ao
POSTGRES_USER=lamanus
POSTGRES_PASSWORD=<palavra-passe forte do DONO da base de dados>
POSTGRES_DB=lamanus
APP_DB_PASSWORD=<palavra-passe forte do papel lamanus_app>
AUTH_DB_PASSWORD=<palavra-passe forte do papel lamanus_auth>
APP_URL=https://lamanu.exemplo.edu.ao
# Envio de email (convites e recuperação de palavra-passe): servidor SMTP da escola. A cifra é obrigatória em produção
# (porta 587 com STARTTLS, ou 465 com SMTP_SEGURO=sim). Utilizador e palavra-passe são secretos: este ficheiro fica em 600.
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURO=nao
SMTP_UTILIZADOR=
SMTP_PALAVRA_PASSE=
SMTP_REMETENTE="Complexo Escolar Lá Manu <nao-responder@dominio-da-escola>"
