// Esquema mínimo da Entrega A (fundação). O modelo completo vem nas entregas B–G (docs/data-model.md).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoAnoLectivo {
  PLANEADO
  ACTIVO
  FECHADO
}

model AnoLectivo {
  id         String           @id @default(uuid()) @db.Uuid
  nome       String           @unique
  inicio     DateTime         @db.Date
  fim        DateTime         @db.Date
  estado     EstadoAnoLectivo @default(PLANEADO)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  turmas     Turma[]
  periodos   Periodo[]
  matriculas Matricula[]
  encargos   Encargo[]
}

model Classe {
  id     String  @id @default(uuid()) @db.Uuid
  nome   String  @unique
  ordem  Int     @unique
  turmas Turma[]
}

model Turma {
  id               String            @id @default(uuid()) @db.Uuid
  nome             String
  turno            String
  classeId         String            @db.Uuid
  anoLectivoId     String            @db.Uuid
  classe           Classe            @relation(fields: [classeId], references: [id])
  anoLectivo       AnoLectivo        @relation(fields: [anoLectivoId], references: [id])
  directorId       String?           @db.Uuid
  director         Funcionario?      @relation("DirectorDeTurma", fields: [directorId], references: [id])
  disciplinas      TurmaDisciplina[]
  matriculas       Matricula[]
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avaliacaos       Avaliacao[]
  pautaPublicacaos PautaPublicacao[]

  @@unique([anoLectivoId, classeId, nome])
  // Permite a chave estrangeira composta da Matricula (a turma TEM de ser do mesmo ano da matrícula).
  @@unique([id, anoLectivoId])
  @@index([directorId])
  @@index([classeId])
  @@index([anoLectivoId])
}

// Dados pessoais: neste momento só existem registos FICTÍCIOS (seed).
model Estudante {
  id             String                 @id @default(uuid()) @db.Uuid
  numeroProcesso String                 @unique
  nome           String
  dataNascimento DateTime               @db.Date
  bi             String?                @unique
  contacto       String?
  estado         EstadoEstudante        @default(ACTIVO)
  matriculas     Matricula[]
  encarregados   EstudanteEncarregado[]
  notas          Nota[]
  encargos       Encargo[]
  pagamentos     Pagamento[]
  userId         String?                @unique @db.Uuid
  user           User?                  @relation(fields: [userId], references: [id])
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([nome])
}

// ───────── Entrega B: identidade, acesso e auditoria ─────────

enum EstadoUtilizador {
  ACTIVO
  BLOQUEADO
  DESACTIVADO
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  email              String           @unique
  nome               String
  passwordHash       String
  estado             EstadoUtilizador @default(ACTIVO)
  tentativasFalhadas Int              @default(0)
  bloqueadoAte       DateTime?
  ultimoLogin        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  papeis             UserRole[]
  sessoes            Session[]
  resets             PasswordReset[]
  estudante          Estudante?
  funcionario        Funcionario?
  encarregado        Encarregado?
}

model Role {
  id         String           @id @default(uuid()) @db.Uuid
  codigo     String           @unique
  nome       String
  users      UserRole[]
  permissoes RolePermission[]
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  codigo    String           @unique
  descricao String
  papeis    RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique
  expiraEm         DateTime
  ultimaActividade DateTime  @default(now())
  ip               String?
  userAgent        String?
  revogadaEm       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Tentativas de login (por identificador e por IP) para bloqueio e análise.
model TentativaLogin {
  id            String   @id @default(uuid()) @db.Uuid
  identificador String
  ip            String?
  sucesso       Boolean
  em            DateTime @default(now())

  @@index([ip, em])
  @@index([identificador, em])
}

// Só inserção: UPDATE/DELETE bloqueados por trigger (ver migração).
model EventoAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  acao       String
  entidade   String
  entidadeId String?
  antes      Json?
  depois     Json?
  ip         String?
  em         DateTime @default(now())

  @@index([actorId])
  @@index([acao, em])
  @@index([entidade, entidadeId])
}

// ───────── Entrega C: estrutura escolar, pessoas e matrículas ─────────

enum EstadoEstudante {
  ACTIVO
  INACTIVO
}

enum TipoMatricula {
  NOVA
  RENOVACAO
}

enum EstadoMatricula {
  ACTIVA
  TRANSFERIDA
  ANULADA
  CONCLUIDA
}

model Periodo {
  id           String            @id @default(uuid()) @db.Uuid
  anoLectivoId String            @db.Uuid
  ordem        Int
  nome         String
  inicio       DateTime          @db.Date
  fim          DateTime          @db.Date
  anoLectivo   AnoLectivo        @relation(fields: [anoLectivoId], references: [id])
  avaliacoes   Avaliacao[]
  pautas       PautaPublicacao[]

  @@unique([anoLectivoId, ordem])
  // Permite as chaves estrangeiras compostas de Avaliacao/PautaPublicacao (o período tem de ser do ano da turma).
  @@unique([id, anoLectivoId])
  @@index([anoLectivoId])
}

model Disciplina {
  id         String            @id @default(uuid()) @db.Uuid
  nome       String            @unique
  archivedAt DateTime?
  turmas     TurmaDisciplina[]
}

model Funcionario {
  id              String            @id @default(uuid()) @db.Uuid
  nome            String
  cargo           String
  userId          String?           @unique @db.Uuid
  user            User?             @relation(fields: [userId], references: [id])
  archivedAt      DateTime?
  createdAt       DateTime          @default(now())
  turmasDirigidas Turma[]           @relation("DirectorDeTurma")
  leccionadas     TurmaDisciplina[]
}

model TurmaDisciplina {
  id           String       @id @default(uuid()) @db.Uuid
  turmaId      String       @db.Uuid
  disciplinaId String       @db.Uuid
  docenteId    String?      @db.Uuid
  turma        Turma        @relation(fields: [turmaId], references: [id])
  disciplina   Disciplina   @relation(fields: [disciplinaId], references: [id])
  docente      Funcionario? @relation(fields: [docenteId], references: [id])
  avaliacoes   Avaliacao[]

  @@unique([turmaId, disciplinaId])
  @@unique([id, turmaId])
  @@index([disciplinaId])
  @@index([docenteId])
}

// Dados pessoais (BI, contactos): só registos FICTÍCIOS fora de produção.
model Encarregado {
  id         String                 @id @default(uuid()) @db.Uuid
  nome       String
  bi         String?                @unique
  contacto   String?
  userId     String?                @unique @db.Uuid
  user       User?                  @relation(fields: [userId], references: [id])
  archivedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  estudantes EstudanteEncarregado[]

  @@index([nome])
}

// O encarregado só vê o educando se `verificado` E `autorizacaoActiva` (e dentro da validade).
model EstudanteEncarregado {
  estudanteId       String      @db.Uuid
  encarregadoId     String      @db.Uuid
  parentesco        String
  verificado        Boolean     @default(false)
  autorizacaoActiva Boolean     @default(true)
  principal         Boolean     @default(false)
  validoDe          DateTime?   @db.Date
  validoAte         DateTime?   @db.Date
  verificadoPorId   String?     @db.Uuid
  verificadoEm      DateTime?
  createdAt         DateTime    @default(now())
  estudante         Estudante   @relation(fields: [estudanteId], references: [id])
  encarregado       Encarregado @relation(fields: [encarregadoId], references: [id])

  @@id([estudanteId, encarregadoId])
  @@index([encarregadoId])
}

model Matricula {
  id           String          @id @default(uuid()) @db.Uuid
  estudanteId  String          @db.Uuid
  turmaId      String          @db.Uuid
  anoLectivoId String          @db.Uuid
  tipo         TipoMatricula
  estado       EstadoMatricula @default(ACTIVA)
  data         DateTime        @default(now())
  createdById  String?         @db.Uuid
  createdAt    DateTime        @default(now())
  estudante    Estudante       @relation(fields: [estudanteId], references: [id])
  anoLectivo   AnoLectivo      @relation(fields: [anoLectivoId], references: [id])
  // Chave composta: a turma tem de pertencer ao mesmo ano lectivo da matrícula (garantido pela BD).
  turma        Turma           @relation(fields: [turmaId, anoLectivoId], references: [id, anoLectivoId])

  @@index([estudanteId])
  @@index([turmaId])
  @@index([anoLectivoId])
}

// ───────── Entrega D: avaliação ─────────

enum TipoAvaliacao {
  TESTE
  TRABALHO
  EXAME
  PARTICIPACAO
  OUTRO
}

enum EstadoPauta {
  RASCUNHO
  VALIDADA
  PUBLICADA
}

// turmaId e anoLectivoId são redundantes de propósito: com as chaves compostas a BASE DE DADOS garante que
// a disciplina é da turma e que o período é do mesmo ano lectivo da turma.
model Avaliacao {
  id                String          @id @default(uuid()) @db.Uuid
  turmaDisciplinaId String          @db.Uuid
  turmaId           String          @db.Uuid
  anoLectivoId      String          @db.Uuid
  periodoId         String          @db.Uuid
  tipo              TipoAvaliacao
  nome              String
  peso              Int
  data              DateTime        @db.Date
  createdById       String?         @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  turmaDisciplina   TurmaDisciplina @relation(fields: [turmaDisciplinaId, turmaId], references: [id, turmaId])
  turma             Turma           @relation(fields: [turmaId, anoLectivoId], references: [id, anoLectivoId])
  periodo           Periodo         @relation(fields: [periodoId, anoLectivoId], references: [id, anoLectivoId])
  notas             Nota[]

  @@index([turmaDisciplinaId])
  @@index([turmaId, periodoId])
  @@index([periodoId])
}

// `valor` em CENTÉSIMAS (14,5 → 1450), 0 a 2000: nunca se calcula com números decimais de vírgula flutuante.
model Nota {
  id           String    @id @default(uuid()) @db.Uuid
  avaliacaoId  String    @db.Uuid
  estudanteId  String    @db.Uuid
  valor        Int
  lancadaPorId String?   @db.Uuid
  lancadaEm    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  avaliacao    Avaliacao @relation(fields: [avaliacaoId], references: [id])
  estudante    Estudante @relation(fields: [estudanteId], references: [id])

  @@unique([avaliacaoId, estudanteId])
  @@index([estudanteId])
}

// Os portais só leem notas de pautas PUBLICADA.
model PautaPublicacao {
  id             String      @id @default(uuid()) @db.Uuid
  turmaId        String      @db.Uuid
  periodoId      String      @db.Uuid
  anoLectivoId   String      @db.Uuid
  estado         EstadoPauta @default(RASCUNHO)
  validadaPorId  String?     @db.Uuid
  validadaEm     DateTime?
  publicadaPorId String?     @db.Uuid
  publicadaEm    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  turma          Turma       @relation(fields: [turmaId, anoLectivoId], references: [id, anoLectivoId])
  periodo        Periodo     @relation(fields: [periodoId, anoLectivoId], references: [id, anoLectivoId])

  @@unique([turmaId, periodoId])
  @@index([periodoId])
}

// ───────── Entrega E: financeiro (livro de movimentos imutável; dinheiro em BigInt de CÊNTIMOS) ─────────

enum Periodicidade {
  MENSAL
  ANUAL
  UNICO
}

enum MetodoPagamento {
  TRANSFERENCIA
  DEPOSITO
  TPA
  NUMERARIO
}

enum EstadoPagamento {
  REGISTADO
  CONFIRMADO
  ESTORNADO
  ANULADO
}

enum ModoAlocacao {
  AUTOMATICO
  MANUAL
}

enum EstadoEstorno {
  PROPOSTO
  APROVADO
  REJEITADO
}

model TipoEncargo {
  id              String        @id @default(uuid()) @db.Uuid
  nome            String        @unique
  valorReferencia BigInt
  periodicidade   Periodicidade
  activo          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  encargos        Encargo[]
}

// O valor de um encargo NUNCA muda. Para corrigir: anular (sem pagamentos líquidos) e criar outro.
model Encargo {
  id             String              @id @default(uuid()) @db.Uuid
  estudanteId    String              @db.Uuid
  tipoEncargoId  String              @db.Uuid
  anoLectivoId   String              @db.Uuid
  referencia     String
  descricao      String
  valor          BigInt
  vencimento     DateTime            @db.Date
  anuladoEm      DateTime?
  anuladoPorId   String?             @db.Uuid
  motivoAnulacao String?
  criadoPorId    String?             @db.Uuid
  createdAt      DateTime            @default(now())
  estudante      Estudante           @relation(fields: [estudanteId], references: [id])
  tipo           TipoEncargo         @relation(fields: [tipoEncargoId], references: [id])
  anoLectivo     AnoLectivo          @relation(fields: [anoLectivoId], references: [id])
  alocacoes      AlocacaoPagamento[]

  @@unique([estudanteId, tipoEncargoId, referencia])
  @@unique([id, estudanteId])
  @@index([estudanteId, vencimento])
  @@index([anoLectivoId])
  @@index([tipoEncargoId])
}

// O valor de um pagamento NUNCA muda. Só passa a CONFIRMADO/ESTORNADO pelas funções da BD que autenticam o autor.
model Pagamento {
  id                String              @id @default(uuid()) @db.Uuid
  estudanteId       String              @db.Uuid
  valor             BigInt
  metodo            MetodoPagamento
  referenciaExterna String?
  nomePagador       String?
  dataPagamento     DateTime            @db.Date
  modoAlocacao      ModoAlocacao        @default(AUTOMATICO)
  estado            EstadoPagamento     @default(REGISTADO)
  registadoPorId    String              @db.Uuid
  confirmadoPorId   String?             @db.Uuid
  confirmadoEm      DateTime?
  anuladoEm         DateTime?
  anuladoPorId      String?             @db.Uuid
  motivoAnulacao    String?
  createdAt         DateTime            @default(now())
  estudante         Estudante           @relation(fields: [estudanteId], references: [id])
  alocacoes         AlocacaoPagamento[]
  estornos          Estorno[]
  recibo            Recibo?

  @@unique([id, estudanteId])
  @@index([estudanteId])
  @@index([estado, dataPagamento])
}

// Só se cria dentro de confirmar_pagamento / alocar_pagamento_manual (funções da BD). Nunca se edita nem apaga.
model AlocacaoPagamento {
  id          String            @id @default(uuid()) @db.Uuid
  pagamentoId String            @db.Uuid
  encargoId   String            @db.Uuid
  estudanteId String            @db.Uuid
  valor       BigInt
  createdAt   DateTime          @default(now())
  pagamento   Pagamento         @relation(fields: [pagamentoId, estudanteId], references: [id, estudanteId])
  encargo     Encargo           @relation(fields: [encargoId, estudanteId], references: [id, estudanteId])
  estornos    EstornoAlocacao[]

  @@unique([id, pagamentoId])
  @@index([pagamentoId])
  @@index([encargoId])
}

model Estorno {
  id            String            @id @default(uuid()) @db.Uuid
  pagamentoId   String            @db.Uuid
  valor         BigInt
  valorCredito  BigInt            @default(0)
  motivo        String
  estado        EstadoEstorno     @default(PROPOSTO)
  propostoPorId String            @db.Uuid
  propostoEm    DateTime          @default(now())
  decididoPorId String?           @db.Uuid
  decididoEm    DateTime?
  motivoDecisao String?
  pagamento     Pagamento         @relation(fields: [pagamentoId], references: [id])
  alocacoes     EstornoAlocacao[]

  @@unique([id, pagamentoId])
  @@index([pagamentoId])
  @@index([estado])
}

// Movimento INVERSO de uma alocação (valores sempre positivos).
model EstornoAlocacao {
  id          String            @id @default(uuid()) @db.Uuid
  estornoId   String            @db.Uuid
  pagamentoId String            @db.Uuid
  alocacaoId  String            @db.Uuid
  valor       BigInt
  createdAt   DateTime          @default(now())
  estorno     Estorno           @relation(fields: [estornoId, pagamentoId], references: [id, pagamentoId])
  alocacao    AlocacaoPagamento @relation(fields: [alocacaoId, pagamentoId], references: [id, pagamentoId])

  @@index([estornoId])
  @@index([alocacaoId])
}

// Contador por série e ano para a numeração SEM SALTOS (linha bloqueada na mesma transacção que emite o recibo).
model SerieRecibo {
  serie   String
  ano     Int
  proximo Int    @default(1)

  @@id([serie, ano])
}

model Recibo {
  id           String    @id @default(uuid()) @db.Uuid
  serie        String
  ano          Int
  numero       Int
  pagamentoId  String    @unique @db.Uuid
  estudanteId  String    @db.Uuid
  valor        BigInt
  emitidoPorId String    @db.Uuid
  emitidoEm    DateTime  @default(now())
  pagamento    Pagamento @relation(fields: [pagamentoId], references: [id])

  @@unique([serie, ano, numero])
  @@index([estudanteId])
}
